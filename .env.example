# ==========================================
# PocketSmart AI Environment Configuration
# ==========================================

# Application
APP_NAME=PocketSmart AI
APP_ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8080

# Security / JWT
JWT_SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Use SQLite for easy local execution without database server setup:
DATABASE_URL=sqlite:///./pocketsmart.db
# Or PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/pocketsmart_db

# Google Gemini AI
# Leave blank to run in intelligent Mock AI mode for development and local testing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MOCK_AI_MODE=auto
